APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=SolarShare
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_COOKIE=buildream_solarshare_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_USER=
MAIL_PASS=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:8000/auth/facebook/callback
FACEBOOK_GRAPH_VERSION=v23.0

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_CURRENCY=usd
STRIPE_TND_TO_CHECKOUT_RATE=0.32

BILLING_TAX_RATE=0.19

# SolarShare AI configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# General local AI provider. Ollama does not require an API key.
AI_ENABLED=true
AI_PROVIDER=ollama
AI_API_KEY=
AI_BASE_URL=http://localhost:11434
AI_MODEL=llama3.2
AI_VISION_MODEL=llava
AI_EMBEDDING_MODEL=nomic-embed-text

# Optional Groq provider for features that explicitly select Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

AI_PARSER_ENABLED=true
AI_STUDIO_ENABLED=true
AI_STUDIO_CHAT_TIMEOUT=12
AI_STUDIO_CHAT_FALLBACK_TIMEOUT=20
AI_STUDIO_VIDEO_TIMEOUT=240

GEMINI_STUDIO_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_STUDIO_VIDEO_MODEL=gemini-omni-1.1-flash

# Maintenance shares GEMINI_API_KEY and provides endpoint/model overrides.
MAINTENANCE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MAINTENANCE_AI_MODEL=gemini-3.5-flash-lite
MAINTENANCE_AI_TRANSCRIPTION_MODEL=whisper-1
MAINTENANCE_AI_TIMEOUT=110
MAINTENANCE_COST_Z_SCORE_THRESHOLD=2
MAINTENANCE_COST_MINIMUM_HISTORY=3
MAINTENANCE_DEFAULT_REPAIR_COST=100
MAINTENANCE_DEFAULT_REPAIR_MINIMUM=80
MAINTENANCE_DEFAULT_REPAIR_MAXIMUM=120

VITE_APP_NAME="${APP_NAME}"

# Laravel Reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8081
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Meilisearch
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=masterKey

# Docker / Laravel Sail Port Overrides
# APP_PORT=80
# FORWARD_DB_PORT=3306
# FORWARD_REDIS_PORT=6379
# FORWARD_MAILPIT_PORT=1025
# FORWARD_MAILPIT_DASHBOARD_PORT=8025
# VITE_PORT=5173
