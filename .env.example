APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Vite dev server; OAuth callbacks below point to the Laravel server.
FRONTEND_URL=http://localhost:5173
# Set this only when deployed behind known reverse proxies (comma-separated IPs).
# TRUSTED_PROXIES=10.0.0.10,10.0.0.11

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Settings
# For local development without Docker: DB_HOST=127.0.0.1
# For Docker / Laravel Sail: DB_HOST=mysql
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tailadmin_laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis Settings
# For local development without Docker: REDIS_HOST=127.0.0.1
# For Docker / Laravel Sail: REDIS_HOST=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local development defaults to log mail. For Gmail SMTP use the standard
# MAIL_USERNAME / MAIL_PASSWORD variables or the MAIL_USER / MAIL_PASS aliases.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_USER=
MAIL_PASS=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:8000/auth/facebook/callback
FACEBOOK_GRAPH_VERSION=v23.0

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_CURRENCY=usd
STRIPE_TND_TO_CHECKOUT_RATE=0.32

BILLING_TAX_RATE=0.19

# Gemini API credentials are kept server-side and never exposed to browsers.
GEMINI_API_KEY=
# Groq handles chat, text/code generation, and reservation request extraction.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Optional free-tier image generation through Cloudflare Workers AI (FLUX.1 Schnell).
# Create a Workers AI API token and copy the Cloudflare Account ID from the dashboard.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
AI_PARSER_ENABLED=true
AI_STUDIO_ENABLED=true
AI_STUDIO_TIMEOUT=60
AI_STUDIO_CHAT_TIMEOUT=12
AI_STUDIO_CHAT_FALLBACK_TIMEOUT=20
AI_STUDIO_VIDEO_TIMEOUT=240
GEMINI_STUDIO_TEXT_MODEL=gemini-3.8-flash
GEMINI_STUDIO_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_STUDIO_CHAT_MODEL=gemini-3.8-flash
GEMINI_STUDIO_VIDEO_MODEL=gemini-omni-1.1-flash

VITE_APP_NAME="${APP_NAME}"

# Docker / Laravel Sail Port Overrides (Optional)
# APP_PORT=80
# FORWARD_DB_PORT=3306
# FORWARD_REDIS_PORT=6379
# FORWARD_MAILPIT_PORT=1025
# FORWARD_MAILPIT_DASHBOARD_PORT=8025
# VITE_PORT=5173
